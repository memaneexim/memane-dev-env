# ============================================================
# _headers — Cloudflare Pages Security & SEO Headers
# ============================================================

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com https://www.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' https://images.unsplash.com https://a.clarity.ms data: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.web3forms.com https://*.clarity.ms; frame-src 'none'; object-src 'none'; base-uri 'self';

# Cache static assets
/uploads/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

# Sitemap — no cache so Google gets fresh version
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

# Robots
/robots.txt
  Cache-Control: public, max-age=3600

# IndexNow key
/mi2025indexnow.txt
  Content-Type: text/plain

# Admin panel — no indexing
/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
